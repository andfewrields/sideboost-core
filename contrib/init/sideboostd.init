#!/usr/bin/env bash
#
#  sideboostd The namecoin core server.
#
#
# chkconfig: 345 80 20
# description: sideboostd
# processname: sideboostd
#

# Source function library.
. /etc/init.d/functions

# you can override defaults in /etc/sysconfig/sideboostd, see below
if [ -f /etc/sysconfig/sideboostd ]; then
        . /etc/sysconfig/sideboostd
fi

RETVAL=0

prog=sideboostd
# you can override the lockfile via BITCOIND_LOCKFILE in /etc/sysconfig/sideboostd
lockfile=${BITCOIND_LOCKFILE-/var/lock/subsys/sideboostd}

# sideboostd defaults to /usr/bin/sideboostd, override with BITCOIND_BIN
sideboostd=${BITCOIND_BIN-/usr/bin/sideboostd}

# sideboostd opts default to -disablewallet, override with BITCOIND_OPTS
namecoind_opts=${BITCOIND_OPTS--disablewallet}

start() {
    echo -n $"Starting $prog: "
    daemon $DAEMONOPTS $sideboostd $namecoind_opts
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && touch $lockfile
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    killproc $prog -t600
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && rm -f $lockfile
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status $prog
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: service $prog {start|stop|status|restart}"
        exit 1
        ;;
esac
